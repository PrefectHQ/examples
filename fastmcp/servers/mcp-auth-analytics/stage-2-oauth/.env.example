# Local DuckDB is the default. Everything works with these unset.
ANALYTICS_DB=local            # or: motherduck
ANALYTICS_API_KEY=demo-shared-key-change-me   # stage 1 only
# Only for ANALYTICS_DB=motherduck:
MOTHERDUCK_READ_TOKEN=        # read scaling token, service account
MOTHERDUCK_RW_TOKEN=          # read/write token with a ttl, service account
